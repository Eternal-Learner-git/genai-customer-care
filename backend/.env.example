# Copy this file to .env and fill in your real values. Never commit the real .env file.

# MySQL connection string: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/complaint_db

# Used to sign JWT tokens. Generate a random string for this, e.g. via: openssl rand -hex 32
SECRET_KEY=replace-this-with-a-long-random-string

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# URLs for the NLP and RAG engine services (see nlp-engine/nlp_service.py and
# rag-engine/rag_service.py). Only change these if you run them on different ports.
NLP_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002
